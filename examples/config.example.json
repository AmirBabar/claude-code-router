{
  "LOG": true,
  "LOG_LEVEL": "info", // Default to info level for examples
  "HOST": "127.0.0.1",
  "PORT": 3456,
  "APIKEY": "YOUR_ROUTER_LOCAL_TOKEN", // Authentication token for the local server
  "API_TIMEOUT_MS": "600000",
  "providers": [
    {
      "name": "zai",
      "api_base_url": "https://api.z.ai/api/paas/v4/chat/completions",
      "api_key": "${ZAI_API_TOKEN}", // Use environment variable for API Key
      "models": ["glm-4.7", "glm-4.5-air","glm-4.5-flash"],
      "transformer": {
        "use": ["tooluse"]
      }
    },
    {
      "name": "deepseek",
      "api_base_url": "https://api.deepseek.com/chat/completions",
      "api_key": "${DEEPSEEK_API_KEY}",
      "models": ["deepseek-chat", "deepseek-reasoner"],
      "transformer": {
        "use": ["deepseek", "anthropic"]
      }
    },
    {
      "name": "gemini",
      "api_base_url": "https://generativelanguage.googleapis.com/v1beta/models/",
      "api_key": "${GEMINI_API_KEY}",
      "models": [
        "gemini-pro-latest",
        "gemini-flash-latest",
        "gemini-2.0-flash-exp"
      ],
      "transformer": {
        "use": ["gemini"]
      }
    },
    {
      "name": "moonshot",
      "api_base_url": "https://api.moonshot.ai/v1/chat/completions",
      "api_key": "${MOONSHOT_API_KEY}",
      "models": ["kimi-k2-thinking-turbo", "kimi-k2-instruct"],
      "transformer": { "use": ["anthropic"] }
    },
    {
      "name": "perplexity",
      "api_base_url": "https://api.perplexity.ai/chat/completions",
      "api_key": "${PERPLEXITY_API_KEY}",
      "models": ["sonar", "sonar-pro", "sonar-reasoning-pro", "sonar-deep-research"],
      "transformer": {
        "use": ["perplexity", "anthropic"]
      }
    }
  ],
  "Router": {
    "default": "deepseek,deepseek-chat",
    "background": "gemini,gemini-flash-latest",
    "think": "moonshot,kimi-k2-thinking-turbo",
    "longContext": "gemini,gemini-pro-latest",
    "longContextThreshold": 60000,
    "webSearch": "perplexity,sonar-pro"
  },
  // IMPORTANT: The path below must be updated to an absolute path for your environment.
  "CUSTOM_ROUTER_PATH": "/path/to/.claude-code-router/custom-router.js"
}
